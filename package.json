{
  "name": "notion-image-uploader",
  "version": "1.0.0",
  "description": "Mac app to upload folders of images to Notion",
  "main": "dist/index.js",
  "bin": {
    "notion-upload": "dist/cli.js"
  },
  "scripts": {
    "gui": "npm run build && npm run start",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "cli": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "notion",
    "image",
    "upload",
    "mac",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^5.6.0",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "glob": "^13.0.0",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.11",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
